generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id                 String       @id @default(uuid())
  title              String
  description        String?
  notionProcessUrl   String?
  delegation         String
  delegationEmail    String?
  responsible        String
  responsibleEmail   String?
  term               DateTime?
  originalTerm       DateTime?
  deadlineTime       String?
  status             TaskStatus   @default(pending)
  recurrence         Recurrence?
  urgency            Urgency
  taskType           TaskType     @default(normal)
  reminderMode       ReminderMode @default(until)
  turboPreviousDay   Boolean      @default(false)
  turboStartTime     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt
  recurrenceAnchor   DateTime?
  dependsOnId        String?
  slackOpenChannelId String?
  slackOpenMessageTs String?
  googleEventId      String?
  googleEventLink    String?
  calendarPrivate    Boolean      @default(false)

  processId String?

  carbonCopies TaskCarbonCopy[]
  reminders    TaskReminderLog[]
  auditLogs    TaskAuditLog[]

  dependsOn  Task?  @relation("TaskDependsOn", fields: [dependsOnId], references: [id])
  dependents Task[] @relation("TaskDependsOn")

  process Process? @relation(fields: [processId], references: [id])

  @@index([processId])
  @@map("tasks")
}

model TaskCarbonCopy {
  id          String   @id @default(uuid())
  taskId      String
  slackUserId String
  email       String?
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, slackUserId])
  @@index([slackUserId])
  @@index([taskId])
  @@map("task-carbon-copies")
}

model TaskReminderLog {
  id        String   @id @default(uuid())
  taskId    String
  dateIso   String
  slot      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dateIso, slot])
  @@index([dateIso, slot])
  @@index([taskId])
  @@map("task-reminder-logs")
}

model GoogleOAuthToken {
  id           String    @id
  refreshToken String
  accessToken  String?
  scope        String?
  tokenType    String?
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("google-oauth-tokens")
}

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  @@index([isActive])
  @@map("admin-users")
}

model Feedback {
  id               String         @id @default(cuid())
  type             FeedbackType
  title            String
  description      String
  attachmentsJson  Json?
  status           FeedbackStatus @default(pending)
  createdBySlackId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([type])
  @@map("feedbacks")
}

model TaskAuditLog {
  id String @id @default(uuid())

  taskId String

  actorSlackId String?
  actorName    String?

  action String

  beforeJson Json?
  afterJson  Json?

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([createdAt])
  @@map("task-audit-log")
}

model Team {
  id          String  @id @default(uuid())
  name        String
  description String?
  color       String?
  group       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   TeamMember[]
  processes Process[]

  @@index([name])
  @@index([group])
  @@map("teams")
}

model TeamMember {
  id String @id @default(uuid())

  teamId String

  slackUserId String
  email       String?

  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, slackUserId])
  @@index([teamId])
  @@index([slackUserId])
  @@map("team-members")
}

model Process {
  id String @id @default(cuid())

  /// ID da página no Notion (imutável)
  notionPageId String @unique

  /// URL da página do processo
  notionPageUrl String

  /// Nome do processo
  title String

  /// Valores exatamente como vêm do Notion
  notionTeam     String
  notionVertical String
  theme          String?

  /// Processo ativo para seleção no FTA
  active Boolean @default(true)

  /// Associação opcional ao Team interno do FTA
  teamId String?

  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([title])
  @@index([teamId])
  @@index([notionVertical])
  @@index([notionVertical, active])
  @@map("processes")
}

enum Urgency {
  light
  asap
  turbo
}

enum ReminderMode {
  until
  from
}

enum TaskType {
  normal
  on_demand
}

enum TaskStatus {
  pending
  blocked
  done
  overdue
  cancelled
}

enum Recurrence {
  daily
  weekly
  biweekly
  monthly
  quarterly
  semiannual
  annual
  none
}

enum FeedbackType {
  bug
  suggestion
}

enum FeedbackStatus {
  pending
  wip
  done
  rejected
}
